#!/bin/sh -eu

# As per the debian package, three cases when we can be called:
#   1) as part of update-ca-certificates -> add / remove certs as instructed
#   2) if first time install -> add all certs
#   3) package update -> do nothing
# We have no way to easily distinguish between first time install
# and package update in OE, so the distinction between cases 2)
# and 3) isn't perfect.

self="$(basename "$0")"
sysroot="${D:-}"
cacerts="${sysroot}@@sysconfdir@@/ssl/certs/java/cacerts"
jvm_libdir="${JVM_LIBDIR:-@@libdir_jvm@@}"
java="${jvm_libdir}/bin/java"

if [ -n "${sysroot}" ] && [ -z "${JVM_LIBDIR:-}" ]; then
    # Called from the postinst during the image build, which must pass in
    # the native JVM. Running the target java on the host is not possible.
    echo "$0: no JVM_LIBDIR specified" >&2
    exit 1
fi

if [ ! -x "${java}" ]; then
    # Should not happen, as the package depends on openjdk.
    echo "$0: ${java} not found" >&2
    exit 1
fi

if [ "${self}" != "@@BPN@@-hook" ] && [ -s "${cacerts}" ]; then
    # Case 3: run directly and the trustStore exists already.
    exit 0
fi

list_certificates() {
    if [ "${self}" = "@@BPN@@-hook" ]; then
        # Case 1: update-ca-certificates passes the changed files on stdin.
        cat
    else
        # Case 2: run directly and there is no trustStore yet, e.g. during
        # the image build. Add all certificates.
        find "${sysroot}@@sysconfdir@@/ssl/certs" -name '*.pem' |
        while read -r filename; do
            echo "+${filename}"
        done
    fi
}

list_certificates | SYSROOT="${sysroot}" "${java}" -Xmx64m \
    -jar "${sysroot}@@datadir_java@@/@@JARFILENAME@@" \
    -storepass changeit
